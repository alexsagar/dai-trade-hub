# Website (Vercel project env vars; copy to .env.local for local development)
NEXT_PUBLIC_SITE_URL=https://dai-trade-hub.vercel.app
# Leave unset during client review. "enabled" (Production only) allows search indexing — see README.
SITE_INDEXING=

# Sanity — leave the project id empty to render the built-in approved content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development          # "production" only on the production deployment
NEXT_PUBLIC_SANITY_STUDIO_URL=                  # e.g. https://dai-trade-hub.sanity.studio (enables click-to-edit + allows framing)
SANITY_API_READ_TOKEN=                          # Viewer token: draft preview only. Server-side, never NEXT_PUBLIC.
SANITY_REVALIDATE_SECRET=                       # shared secret for the publish webhook
SANITY_API_WRITE_TOKEN=                         # Editor token, ONLY for running scripts/seed-sanity.ts locally. Do not add to Vercel.

# Contact form (unchanged in this milestone)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
CONTACT_TO_EMAIL=
TRADE_TO_EMAIL=
